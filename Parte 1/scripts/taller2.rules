# Caso 8: escaneo de puertos (>=20 SYN en 60 s del mismo origen)
alert tcp any any -> $HOME_NET ![80,443] (msg:"T2 Caso8 escaneo de puertos SYN"; flags:S,12; threshold:type threshold, track by_src, count 20, seconds 60; classtype:attempted-recon; sid:9000008; rev:1;)

# Caso 1: SYN flood (>=300 SYN en 10 s hacia el mismo destino)
alert tcp any any -> 192.168.50.20 80 (msg:"T2 Caso1 posible SYN flood"; flags:S,12; threshold:type threshold, track by_dst, count 300, seconds 10; classtype:attempted-dos; sid:9000001; rev:1;)

# Caso 2: DNS con nombre largo (>50 caracteres)
alert dns any any -> any any (msg:"T2 Caso2 consulta DNS con nombre largo"; dns.query; content:"."; pcre:"/^.{50,}$/"; threshold:type threshold, track by_src, count 20, seconds 60; classtype:bad-unknown; sid:9000002; rev:1;)

# Caso 5: RST del servidor (>=5 en 60 s hacia el mismo destino)
alert tcp 192.168.50.20 80 -> any any (msg:"T2 Caso5 rafaga de RST del servidor"; flags:R; threshold:type threshold, track by_dst, count 5, seconds 60; classtype:bad-unknown; sid:9000005; rev:1;)

# Caso 6: respuestas DNS desde UDP/53 hacia un mismo destino (>=200 en 10 s)
alert udp any 53 -> any any (msg:"T2 Caso6 posible reflexion DNS"; threshold:type threshold, track by_dst, count 200, seconds 10; classtype:attempted-dos; sid:9000006; rev:1;)

# Caso 7: echo request ICMP grande (frame >100 B)
alert icmp any any -> any any (msg:"T2 Caso7 ICMP echo grande"; itype:8; dsize:>100; threshold:type threshold, track by_src, count 10, seconds 60; classtype:bad-unknown; sid:9000007; rev:1;)
